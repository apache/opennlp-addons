   Project-authored LexiconExtension fixture modeled on the official Global WordNet
   Association computer-process example at
   https://globalwordnet.github.io/schemas/#wordnet-extensions. It extends the base
   lexicon in extension-base.xml, which lives in a separate file because the format
   forbids a base and its extension sharing one document. The reduced content is
   written for this test and copies no source definitions.
-->
<LexicalResource xmlns:dc="https://globalwordnet.github.io/schemas/dc/">
  <LexiconExtension id="ewn-cs-example"
                    label="English WordNet Computer Science Terms (example)"
                    language="en"
                    version="1.0"
                    license="https://creativecommons.org/publicdomain/zero/1.0/"
                    dc:publisher="OpenNLP test fixture">
    <Extends ref="ewn" version="2020"/>
    <Requires ref="omw-fr" version="1.4" url="https://example.org/omw-fr-1.4.xml"/>
    <ExternalLexicalEntry id="ewn-process-n">
      <Sense id="ewn-process-n-20000123" synset="ewn-20000123-n"/>
    </ExternalLexicalEntry>
    <LexicalEntry id="ewn-cs-daemon-n">
      <Lemma writtenForm="daemon" partOfSpeech="n"/>
      <Sense id="ewn-cs-daemon-n-20000124" synset="ewn-20000124-n"/>
    </LexicalEntry>
    <ExternalSynset id="ewn-06581154-n"/>
    <Synset id="ewn-20000123-n" partOfSpeech="n">
      <Definition>a running instance of a computer program</Definition>
      <SynsetRelation relType="hypernym" target="ewn-06581154-n"/>
    </Synset>
    <Synset id="ewn-20000124-n" partOfSpeech="n">
      <Definition>a background process that answers requests for services</Definition>
      <SynsetRelation relType="hypernym" target="ewn-20000123-n"/>
    </Synset>
  </LexiconExtension>
</LexicalResource>
